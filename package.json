{
  "name": "tax-ais",
  "version": "1.0.0",
  "description": "100% In-Browser Indian Income Tax Annual Information Statement (AIS) Extraction Engine & Reconciliation Dashboard",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsx tests/extractor.test.ts",
    "lint": "eslint src/ index.html",
    "lint:fix": "eslint src/ index.html --fix",
    "stylelint": "stylelint 'src/**/*.{css,scss}'",
    "stylelint:fix": "stylelint 'src/**/*.{css,scss}' --fix",
    "sonar:check": "eslint src/ index.html && stylelint 'src/**/*.{css,scss}' && tsc --noEmit",
    "sonar:scan": "sonar-scanner",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/svinayaka/Tax-AIS.git"
  },
  "keywords": [
    "ais",
    "annual-information-statement",
    "form-168",
    "form-26as",
    "income-tax-india",
    "pdf-parser",
    "fintech",
    "tax-tech",
    "tds-tcs",
    "json-schema"
  ],
  "author": "Siddi Vinayaka",
  "license": "MIT",
  "devDependencies": {
    "@html-eslint/eslint-plugin": "^0.66.1",
    "@html-eslint/parser": "^0.66.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^3.0.7",
    "eslint-plugin-unicorn": "^59.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "sass": "^1.105.1",
    "sonarqube-scanner": "^5.0.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@stencil/core": "^4.45.2",
    "@svinayaka/siddi-design-system": "^1.0.0",
    "canvas-confetti": "^1.9.4",
    "lucide": "^1.52.0",
    "pdfjs-dist": "^6.4.299"
  }
}
